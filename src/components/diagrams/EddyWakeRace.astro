---
<svg class="dgm eddy-wake-race" viewBox="0 0 860 430" role="img" aria-label="Lost wakeup comparison. In the naive sequence a wake arrives while a task is running and disappears when the worker clears the running flag. Eddy records NOTIFIED atomically and requeues the task after poll returns Pending.">
  <defs>
    <marker id="ewr-arrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 10 5 0 10z" class="dgm-arrow" /></marker>
    <marker id="ewr-red" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" height="7" orient="auto"><path d="M0 0 10 5 0 10z" class="ewr-red-fill" /></marker>
    <marker id="ewr-green" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" height="7" orient="auto"><path d="M0 0 10 5 0 10z" class="ewr-green-fill" /></marker>
  </defs>
  <text x="24" y="28" class="dgm-sub">THE SAME INTERLEAVING · TWO OUTCOMES</text>
  <text x="24" y="70" class="dgm-title">Naive flags</text>
  <text x="836" y="70" text-anchor="end" class="dgm-sub ewr-red-text">wake disappears</text>
  <line x1="170" y1="96" x2="790" y2="96" class="dgm-line" marker-end="url(#ewr-arrow)" />
  <circle cx="220" cy="96" r="5" class="ewr-dot" /><text x="220" y="122" text-anchor="middle" class="dgm-sub">poll starts</text>
  <circle cx="420" cy="96" r="5" class="ewr-red" /><text x="420" y="122" text-anchor="middle" class="dgm-sub">wake</text>
  <circle cx="625" cy="96" r="5" class="ewr-red" /><text x="625" y="122" text-anchor="middle" class="dgm-sub">Pending</text>
  <circle cx="770" cy="96" r="5" class="ewr-red" /><text x="770" y="122" text-anchor="middle" class="dgm-sub">lost</text>
  <rect x="244" y="143" width="136" height="38" rx="6" class="dgm-box" /><text x="312" y="167" text-anchor="middle" class="dgm-label">RUNNING = 1</text>
  <path d="M420 143v38" class="ewr-red-line" marker-end="url(#ewr-red)" />
  <rect x="456" y="143" width="136" height="38" rx="6" class="dgm-box" /><text x="524" y="167" text-anchor="middle" class="dgm-label">wake ignored</text>
  <path d="M625 143v38" class="ewr-red-line" marker-end="url(#ewr-red)" />
  <rect x="662" y="143" width="136" height="38" rx="6" class="dgm-box" /><text x="730" y="167" text-anchor="middle" class="dgm-label">RUNNING = 0</text>

  <text x="24" y="243" class="dgm-title">Eddy's packed state</text>
  <text x="836" y="243" text-anchor="end" class="dgm-sub ewr-green-text">wake is replayed</text>
  <line x1="170" y1="269" x2="790" y2="269" class="dgm-line" marker-end="url(#ewr-arrow)" />
  <circle cx="220" cy="269" r="5" class="ewr-dot" /><text x="220" y="295" text-anchor="middle" class="dgm-sub">poll starts</text>
  <circle cx="420" cy="269" r="5" class="ewr-green" /><text x="420" y="295" text-anchor="middle" class="dgm-sub">wake</text>
  <circle cx="625" cy="269" r="5" class="ewr-green" /><text x="625" y="295" text-anchor="middle" class="dgm-sub">Pending</text>
  <circle cx="770" cy="269" r="5" class="ewr-green" /><text x="770" y="295" text-anchor="middle" class="dgm-sub">requeue</text>
  <rect x="244" y="316" width="136" height="38" rx="6" class="dgm-box dgm-box--accent" /><text x="312" y="340" text-anchor="middle" class="dgm-label">RUNNING | 0</text>
  <path d="M420 316v38" class="ewr-green-line" marker-end="url(#ewr-green)" />
  <rect x="456" y="316" width="136" height="38" rx="6" class="dgm-box dgm-box--accent" /><text x="524" y="340" text-anchor="middle" class="dgm-label">NOTIFIED = 1</text>
  <path d="M625 316v38" class="ewr-green-line" marker-end="url(#ewr-green)" />
  <rect x="662" y="316" width="136" height="38" rx="6" class="dgm-box dgm-box--accent" /><text x="730" y="340" text-anchor="middle" class="dgm-label">OkNotified</text>
  <text x="430" y="407" text-anchor="middle" class="dgm-sub dgm-sub--accent">the wake is not a second queue entry; it is one bit that survives the poll</text>
  <style>
    .ewr-dot { fill: var(--ink); }
    .ewr-red { fill: var(--accent-2); }
    .ewr-green { fill: #4f8063; }
    .ewr-red-line { stroke: var(--accent-2); stroke-width: 1.6; }
    .ewr-green-line { stroke: #4f8063; stroke-width: 1.6; }
    .ewr-red-fill { fill: var(--accent-2); }
    .ewr-green-fill { fill: #4f8063; }
    .ewr-red-text { fill: var(--accent-2); }
    .ewr-green-text { fill: #4f8063; }
  </style>
</svg>
