---
// GitHub contribution heatmap, fetched client-side and rendered in the Ledger palette.
// Month + weekday axes, a themed scrollbar, and a hover tooltip. Hides itself if the source is down.
const user = 'sanskarpan';
---

<div class="ghc" data-user={user}>
  <div class="ghc__head">
    <span class="ghc__total" data-ghc-total>&nbsp;</span>
    <span class="ghc__cap">contributions in the last year</span>
  </div>

  <div class="ghc__scroll">
    <div class="ghc__cal">
      <div class="ghc__corner"></div>
      <div class="ghc__months" data-ghc-months></div>
      <div class="ghc__days">
        <span style="grid-row:2">Mon</span>
        <span style="grid-row:4">Wed</span>
        <span style="grid-row:6">Fri</span>
      </div>
      <div class="ghc__grid" data-ghc-grid role="img" aria-label="GitHub contribution graph for the last year"></div>
    </div>
  </div>

  <div class="ghc__legend" aria-hidden="true">
    <span>Less</span>
    <span class="ghc-cell" data-l="0"></span>
    <span class="ghc-cell" data-l="1"></span>
    <span class="ghc-cell" data-l="2"></span>
    <span class="ghc-cell" data-l="3"></span>
    <span class="ghc-cell" data-l="4"></span>
    <span>More</span>
  </div>

  <div class="ghc__tip" data-ghc-tip hidden></div>
</div>

<script>
  (async function () {
    var root = document.querySelector('.ghc');
    if (!root) return;
    var user = root.getAttribute('data-user');
    var grid = root.querySelector('[data-ghc-grid]');
    var monthsEl = root.querySelector('[data-ghc-months]');
    var totalEl = root.querySelector('[data-ghc-total]');
    var tip = root.querySelector('[data-ghc-tip]');
    var MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

    function fmt(dateStr) {
      var d = new Date(dateStr + 'T00:00:00');
      return MON[d.getMonth()] + ' ' + d.getDate() + ', ' + d.getFullYear();
    }

    try {
      var res = await fetch('https://github-contributions-api.jogruber.de/v4/' + user + '?y=last');
      if (!res.ok) throw new Error('status ' + res.status);
      var data = await res.json();
      var days = data.contributions || [];
      if (!days.length) throw new Error('no data');

      var total = (data.total && data.total.lastYear) || days.reduce(function (s, d) { return s + (d.count || 0); }, 0);
      if (totalEl) totalEl.textContent = total.toLocaleString();

      var firstDate = new Date(days[0].date + 'T00:00:00');
      var pad = firstDate.getDay(); // 0 = Sunday

      // cells: pad the first partial week, then one cell per day, flowing down each column
      var frag = document.createDocumentFragment();
      for (var i = 0; i < pad; i++) {
        var e = document.createElement('span');
        e.className = 'ghc-cell ghc-cell--empty';
        frag.appendChild(e);
      }
      days.forEach(function (d) {
        var c = document.createElement('span');
        c.className = 'ghc-cell';
        c.setAttribute('data-l', String(d.level || 0));
        c.dataset.count = String(d.count || 0);
        c.dataset.date = d.date;
        frag.appendChild(c);
      });
      grid.appendChild(frag);

      // find the first column of each month, then only label ones wide enough to not collide
      var numWeeks = Math.ceil((pad + days.length) / 7);
      var changes = [];
      var lastMonth = -1;
      for (var w = 0; w < numWeeks; w++) {
        var ds = new Date(firstDate.getTime());
        ds.setDate(ds.getDate() + w * 7 - pad); // Sunday of week w
        var m = ds.getMonth();
        if (m !== lastMonth) { lastMonth = m; changes.push({ m: m, col: w }); }
      }
      changes.forEach(function (cur, i) {
        var next = changes[i + 1];
        // skip a leading/trailing partial month that is too narrow to fit its label
        if (next && next.col - cur.col < 3) return;
        var lab = document.createElement('span');
        lab.className = 'ghc__month';
        lab.textContent = MON[cur.m];
        lab.style.gridColumnStart = String(cur.col + 1);
        monthsEl.appendChild(lab);
      });

      // hover tooltip via delegation
      grid.addEventListener('mouseover', function (ev) {
        var t = ev.target;
        if (!t.dataset || t.dataset.count === undefined) return;
        var n = parseInt(t.dataset.count, 10);
        tip.textContent = (n === 0 ? 'No contributions' : n + (n === 1 ? ' contribution' : ' contributions')) + ' on ' + fmt(t.dataset.date);
        tip.hidden = false;
        var r = t.getBoundingClientRect();
        tip.style.left = (r.left + r.width / 2) + 'px';
        tip.style.top = r.top + 'px';
      });
      grid.addEventListener('mouseout', function () { tip.hidden = true; });
    } catch (err) {
      root.style.display = 'none';
    }
  })();
</script>
