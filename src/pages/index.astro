---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { PROJECTS } from '../data/projects';
import { formatDate, pad } from '../utils';
import { SITE } from '../consts';
import GitHubContributions from '../components/GitHubContributions.astro';
import RecentRepos from '../components/RecentRepos.astro';
import TechStack from '../components/TechStack.astro';
import Tag from '../components/Tag.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestPosts = posts.slice(0, 3);

const notes = (await getCollection('notes'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestNotes = notes.slice(0, 2);

const featured = PROJECTS.filter((p) => p.featured).slice(0, 6);

// What the work actually is (not a project list).
const FOCUS = [
  { name: 'Storage engines', blurb: 'LSM-trees and B+Trees from scratch: WAL, MVCC, compaction, and crash recovery.' },
  { name: 'Distributed systems', blurb: 'Raft, replication strategies, gossip, and tracing, plus the failure modes underneath.' },
  { name: 'Backend & APIs', blurb: 'Payment infrastructure, gRPC services, queues, reverse proxies, and the reliability plumbing.' },
  { name: 'LLM & agent infra', blurb: 'Agent runtimes, prompt-optimization pipelines, evals, and MCP tooling.' },
];

// A curated path for first-time readers.
const START_HERE = ['harness-engineering', 'building-an-mcp-server-from-scratch', 'an-lsm-tree-in-go'];
const pathPosts = START_HERE.map((s) => posts.find((p) => p.id === s)).filter(Boolean);

// Topics, from writing + notes, sized by frequency. Synced with the tag links everywhere.
const tagCounts: Record<string, number> = {};
[...posts, ...notes].forEach((e) => e.data.tags.forEach((t) => { tagCounts[t] = (tagCounts[t] || 0) + 1; }));
const topics = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<Base>
  <div class="wrap">
    <!-- HERO -->
    <section class="hero">
      <p class="label hero__eyebrow rise rise-1">{SITE.tagline}</p>
      <h1 class="rise rise-2">
        I build systems that <em>hold up</em>, and write about how.
      </h1>
      <p class="hero__lede rise rise-3">
        I&rsquo;m Sanskar. I work across storage engines, backend infrastructure, LLM
        systems, and agents, mostly by building them from scratch. This is my notebook:
        <a href="/writing">long-form writing</a>, the
        <a href="/projects">things I&rsquo;ve built</a>, and
        <a href="/notes">rougher notes</a> in the margins.
      </p>
      <div class="btnrow rise rise-4">
        <a class="btn btn--accent" href="/writing">Read the writing →</a>
        <a class="btn" href="https://github.com/sanskarpan">GitHub ↗</a>
      </div>
    </section>

    <!-- START HERE -->
    <section class="section" data-selftab>
      <div class="section__head"><span class="label">Start here</span></div>
      <ol class="path">
        {pathPosts.map((p, i) => (
          <li>
            <a href={`/writing/${p.id}/`}>
              <span class="path__no">{pad(i + 1)}</span>
              <span class="path__title">{p.data.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <!-- GITHUB CONTRIBUTIONS -->
    <section class="section">
      <div class="section__head">
        <span class="label">On GitHub</span>
        <a class="more" href="https://github.com/sanskarpan">@sanskarpan ↗</a>
      </div>
      <GitHubContributions />
    </section>

    <!-- WRITING -->
    <section class="section" data-selftab>
      <div class="section__head">
        <span class="label">Selected writing</span>
        <a class="more" href="/writing">all writing →</a>
      </div>
      <ul class="entries">
        {latestPosts.map((p, i) => (
          <li class="entry">
            <span class="entry__no">{pad(i + 1)}</span>
            <a href={`/writing/${p.id}/`} class="entry__title">{p.data.title}</a>
            <div class="entry__meta">
              <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
              {p.data.tags.slice(0, 2).map((t) => <Tag tag={t} />)}
            </div>
            <p class="entry__desc">{p.data.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- PROJECTS -->
    <section class="section">
      <div class="section__head">
        <span class="label">Selected work</span>
        <a class="more" href="/projects">all projects →</a>
      </div>
      <div class="cards">
        {featured.map((p) => (
          <a class="card" href={p.href} rel="noopener">
            <div class="card__top">
              <span class="card__name">{p.name}</span>
              {p.badge && <span class="card__badge">{p.badge}</span>}
            </div>
            <p class="card__desc">{p.blurb}</p>
            <span class="card__stack">{p.stack}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- WHAT I WORK ON -->
    <section class="section">
      <div class="section__head">
        <span class="label">What I work on</span>
        <a class="more" href="/projects/all">all projects →</a>
      </div>
      <div class="cards">
        {FOCUS.map((f) => (
          <div class="card card--static">
            <div class="card__top"><span class="card__name">{f.name}</span></div>
            <p class="card__desc">{f.blurb}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- THE STACK -->
    <section class="section">
      <div class="section__head">
        <span class="label">The stack</span>
        <a class="more" href="/uses">what I use →</a>
      </div>
      <TechStack />
    </section>

    <!-- TOPICS -->
    <section class="section">
      <div class="section__head"><span class="label">Topics</span></div>
      <div class="topics">
        {topics.map(([t, n]) => (
          <a href={`/topics/${t}/`} class="topic">
            {t}<span class="topic__n">{n}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- RECENTLY ACTIVE -->
    <section class="section">
      <div class="section__head">
        <span class="label">Recently active</span>
        <a class="more" href="https://github.com/sanskarpan?tab=repositories&sort=pushed">on GitHub ↗</a>
      </div>
      <RecentRepos />
    </section>

    <!-- NOTES -->
    <section class="section" data-selftab>
      <div class="section__head">
        <span class="label">From the margins</span>
        <a class="more" href="/notes">all notes →</a>
      </div>
      <ul class="entries">
        {latestNotes.map((n) => (
          <li class="entry">
            <span class="entry__no stage" data-stage={n.data.stage}>{n.data.stage}</span>
            <a href={`/notes/${n.id}/`} class="entry__title">{n.data.title}</a>
            <div class="entry__meta">
              <time datetime={n.data.date.toISOString()}>planted {formatDate(n.data.date)}</time>
              {n.data.tags.slice(0, 2).map((t) => <Tag tag={t} />)}
            </div>
            {n.data.description && <p class="entry__desc">{n.data.description}</p>}
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
