---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { PROJECTS } from '../data/projects';

// The main projects page: a tight, high-signal shortlist.
// The full, theme-grouped catalogue lives at /projects/all.
const shortlist = PROJECTS.filter((p) => p.flat);
---

<Base title="Projects" description="Storage engines, distributed systems, agent tooling, and payment infra, mostly open source.">
  <div class="wrap">
    <section class="hero" style="padding-block: 3.5rem 1rem;">
      <p class="label hero__eyebrow rise rise-1">Selected work</p>
      <h1 class="rise rise-2">Projects</h1>
      <p class="hero__lede rise rise-3" style="margin-top:1rem;">
        A short list of the work I&rsquo;d point a stranger at first: storage engines
        and distributed systems in Go, agent and LLM tooling in Python, and a payment
        platform. Most are open source.
      </p>
    </section>

    <section class="section rise rise-4" style="border-top:0; padding-top:0;">
      <div class="cards">
        {shortlist.map((p) => <ProjectCard project={p} />)}
      </div>
      <p style="margin-top:1.75rem; font-family: var(--font-mono); font-size:0.82rem;">
        <a href="/projects/all" style="color:var(--accent);">Browse everything, grouped by theme →</a>
      </p>
    </section>
  </div>
</Base>
