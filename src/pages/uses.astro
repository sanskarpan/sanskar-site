---
import Base from '../layouts/Base.astro';

const GROUPS = [
  { label: 'Languages', items: [
    'Go · services, storage, systems work',
    'Python · AI and backend',
    'TypeScript · web and SDKs',
    'C++ · lower-level work',
    'Rust · still learning it',
  ] },
  { label: 'Backend & data', items: [
    'PostgreSQL · the default',
    'Redis · cache, queues, rate limits',
    'Kafka / NATS · streaming',
    'FastAPI · Python services',
    'gRPC + Protobuf · service contracts',
    'SQLite · local state',
  ] },
  { label: 'Infra & deploy', items: [
    'Docker',
    'Kubernetes + Helm',
    'Terraform',
    'Cloudflare · the edge, and this site',
    'GitHub Actions · CI',
  ] },
  { label: 'Observability', items: [
    'Prometheus + Grafana',
    'OpenTelemetry · traces',
    'structured logs',
  ] },
  { label: 'AI & LLM', items: [
    'MCP / FastMCP',
    'OpenRouter · multi-provider',
    'Anthropic · OpenAI · open models',
    'PromptLine · my own evals',
    'pgvector · embeddings',
  ] },
  { label: 'Editor & terminal', items: [
    'Neovim / VS Code',
    'Ghostty + tmux',
    'zsh + starship',
    'Claude Code',
  ] },
  { label: 'This site', items: [
    'Astro + MDX',
    'hand-written CSS, no Tailwind',
    'Pagefind · search',
    'Cloudflare · deploy',
  ] },
  { label: 'Machine', items: [
    'MacBook Pro · Apple silicon',
    'External monitor',
    'Mechanical keyboard',
  ] },
];
---

<Base title="Uses" description="The tools, languages, and stack I actually reach for.">
  <div class="wrap">
    <section class="hero" style="padding-block: 3.5rem 1rem;">
      <p class="label hero__eyebrow rise rise-1">/uses</p>
      <h1 class="rise rise-2">What I use</h1>
      <p class="hero__lede rise rise-3" style="margin-top:1rem;">
        The tools behind the work. Updated when the setup actually changes.
      </p>
    </section>

    <section class="section rise rise-4" style="border-top:0; padding-top:0.5rem;">
      {GROUPS.map((g) => (
        <div class="uses-row">
          <span class="label">{g.label}</span>
          <ul class="uses-items">
            {g.items.map((it) => <li>{it}</li>)}
          </ul>
        </div>
      ))}
    </section>
  </div>
</Base>
