---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}
const { title, description, image, type } = Astro.props;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <BaseHead title={title} description={description} image={image} type={type} />
  </head>
  <body>
    <Header />
    <main class="page" id="main">
      <slot />
    </main>
    <Footer />

    <!-- Every navigating link opens in a new tab; only in-page (#) anchors stay put. -->
    <script is:inline>
      (function () {
        document.querySelectorAll('a[href]').forEach(function (a) {
          var href = a.getAttribute('href') || '';
          if (!href || href.charAt(0) === '#') return;        // in-page anchors (TOC, headings)
          if (/^(mailto:|tel:)/i.test(href)) return;          // let the OS handler take these
          if (a.closest('[data-selftab]')) return;            // sections that navigate in place
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
        });
      })();
    </script>
  </body>
</html>
